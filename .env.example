# --- InfluxDB Initial Setup Credentials (Used by Docker Compose) ---
DOCKER_INFLUXDB_INIT_USERNAME=iot_project
DOCKER_INFLUXDB_INIT_PASSWORD=your_influxdb_password_here
DOCKER_INFLUXDB_INIT_ORG=iot_project
DOCKER_INFLUXDB_INIT_BUCKET=livestock_telemetry
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=your_admin_token_here

# --- Client Connection Settings (Used by processor.py) ---
INFLUX_URL=http://localhost:8086
INFLUX_ORG=iot_project
INFLUX_BUCKET=livestock_telemetry
INFLUX_TOKEN=your_admin_token_here

# --- MQTT Credentials ---
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=farm_admin
MQTT_PASS=your_mqtt_password_here